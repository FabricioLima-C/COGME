height="222"/><g class="label" style="color:#FFFFFF !important" transform="translate(-100, -96)"><rect/><foreignObject width="200" height="192"><div style="color: rgb(255, 255, 255) !important; display: table; white-space: break-spaces; line-height: 1.5; max-width: 200px; text-align: center; width: 200px;" xmlns="http://www.w3.org/1999/xhtml"><span style="color:#FFFFFF !important" class="nodeLabel"><p><b>CAMADA 1 — GOVERNANÇA PRIMÁRIA</b><br />PMBOK® 7ª Edição<br />12 Princípios + 8 Domínios de Desempenho<br /><i>Define por que e para quê — orienta decisões por valor</i></p></span></div></foreignObject></g></g><g class="node default dicionario" id="my-svg-flowchart-L2-1" data-look="classic" transform="translate(138, 463)"><rect class="basic label-container" style="fill:#F5F5F5 !important;stroke:#616161 !important;stroke-width:2px !important;stroke-dasharray:6 3 !important" x="-130" y="-135" width="260" height="270"/><g class="label" style="color:#212121 !important" transform="translate(-100, -120)"><rect/><foreignObject width="200" height="240"><div style="color: rgb(33, 33, 33) !important; display: table; white-space: break-spaces; line-height: 1.5; max-width: 200px; text-align: center; width: 200px;" xmlns="http://www.w3.org/1999/xhtml"><span style="color:#212121 !important" class="nodeLabel"><p><b>CAMADA 2 — DICIONÁRIO COMPLEMENTAR</b><br />PMBOK® 6ª Edição (2017)<br />Processos 4.1–4.7 citados para rastreabilidade acadêmica<br />⚠ OBSOLESCÊNCIA ASSUMIDA — EVM (SPI/CPI) = LEGADO</p></span></div></foreignObject></g></g><g class="node default execucao" id="my-svg-flowchart-L3-2" data-look="classic" transform="translate(270.5, 795)"><rect class="basic label-container" style="fill:#0E8A16 !important;stroke:#075B0E !important;stroke-width:2px !important" x="-130" y="-123" width="260" height="246"/><g class="label" style="color:#FFFFFF !important" transform="translate(-100, -108)"><rect/><foreignObject width="200" height="216"><div style="color: rgb(255, 255, 255) !important; display: table; white-space: break-spaces; line-height: 1.5; max-width: 200px; text-align: center; width: 200px;" xmlns="http://www.w3.org/1999/xhtml"><span style="color:#FFFFFF !important" class="nodeLabel"><p><b>CAMADA 3 — MÉTODO DE EXECUÇÃO</b><br />Manifesto Ágil (4 valores) + Kanban (fluxo contínuo)<br />GitHub Projects como Fonte Única de Verdade (SSOT)<br /><i>Define como o trabalho é executado diariamente</i></p></span></div></foreignObject></g></g></g></g><marker id="my-svg_flowchart-v2-pointEnd__333333" class="marker flowchart-v2" viewBox="0 0 10 10" refX="5" refY="5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" class="arrowMarkerPath" style="stroke-width: 1; stroke-dasharray: 1, 0;" stroke="#333333" fill="#333333"/></marker><marker id="my-svg_flowchart-v2-pointEnd__B60205" class="marker flowchart-v2" viewBox="0 0 10 10" refX="5" refY="5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" class="arrowMarkerPath" style="stroke-width: 1; stroke-dasharray: 1, 0;" stroke="#B60205" fill="#B60205"/></marker></g><defs><filter id="my-svg-drop-shadow" height="130%" width="130%"><feDropShadow dx="4" dy="4" stdDeviation="0" flood-opacity="0.06" flood-color="#000000"/></filter></defs><defs><filter id="my-svg-drop-shadow-small" height="150%" width="150%"><feDropShadow dx="2" dy="2" stdDeviation="0" flood-opacity="0.06" flood-color="#000000"/></filter></defs><linearGradient id="my-svg-gradient" gradientUnits="objectBoundingBox" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="hsl(40.5882352941, 60%, 83.3333333333%)" stop-opacity="1"/><stop offset="100%" stop-color="hsl(-79.4117647059, 60%, 83.3333333333%)" stop-opacity="1"/></linearGradient></svg>